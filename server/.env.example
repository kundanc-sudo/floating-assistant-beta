# Backend-only environment variables. Never place these values in the root
# Electron/Vite environment or commit real credentials.
NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:change_me@localhost:5432/floating_assistant
# "url" reads sslmode from DATABASE_URL. Use "require" for a managed
# database URL that must use TLS but cannot be edited (for example, a Blueprint reference).
DATABASE_SSL_MODE=url
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

AI_PROVIDER_KEY=
AI_FAST_MODEL=gpt-5.6-luna
AI_CODING_MODEL=gpt-5.6-sol
AI_SUMMARY_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=120000

AUTH_SESSION_TTL_HOURS=168
AUTH_MAX_SESSIONS_PER_USER=10
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

PUBLIC_BASE_URL=http://localhost:3001
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:5173

# Use "console" only for local development. Production requires "resend" or "webhook".
EMAIL_PROVIDER=console
# Required only for the generic webhook provider. Resend uses its fixed official API URL.
EMAIL_PROVIDER_URL=
# For Render/production, set EMAIL_PROVIDER=resend and provide these two values
# through the server-side secret manager. Never use a VITE_ prefix.
EMAIL_PROVIDER_KEY=
EMAIL_FROM=no-reply@example.com

BETA_MODE=false
BETA_DAILY_AI_REQUESTS=100
BETA_DAILY_TOKENS=250000
BETA_CONCURRENT_AI_REQUESTS=2

SHARE_SESSION_TTL_MINUTES=60
SHARE_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
VIEWER_BASE_URL=http://localhost:3001
