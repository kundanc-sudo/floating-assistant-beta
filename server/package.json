{
  "name": "windows-overlay-assistant-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.mjs test/*.test.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:runtime": "node dist/cli/migrateDatabase.js",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "beta:create-invite": "tsx src/cli/createInvite.ts",
    "db:verify": "tsx src/cli/verifyDatabase.ts",
    "db:verify-fresh": "tsx src/cli/verifyFreshMigration.ts",
    "smoke:auth": "tsx src/cli/verifyAuthFlow.ts",
    "smoke:built": "node test/builtServerSmoke.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
